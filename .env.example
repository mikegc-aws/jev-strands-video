# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Jev is reached through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# The demos' agent uses Strands' default Amazon Bedrock provider, which relies
# on your ambient AWS credentials (e.g. from `aws configure`, SSO, or the
# environment). No extra key is needed here for Bedrock, but you must have
# model access enabled in the Bedrock console.
